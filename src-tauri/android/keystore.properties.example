# Copy to src-tauri/gen/android/keystore.properties after `npm run tauri:android:init`
# and run scripts/patch-android-release-signing.ps1 once (see ANDROID.md).
#
# For Play Store / production, generate your own keystore:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# https://v2.tauri.app/distribute/sign/android/

password=your-keystore-password
keyAlias=upload
storeFile=C:\\Users\\You\\upload-keystore.jks
